{
  "name": "aharonach/wordpress-composer-boilerplate",
  "description": "Lightweight WordPress boilerplate with Composer-managed packages in src/, compatible with Apache, Laravel Herd, and standard local PHP stacks.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "johnpbloch/wordpress": "*",
    "aharonach/custom-plugin": "*",
    "aharonach/custom-theme": "*",
    "wpackagist-plugin/seo-by-rank-math": "*"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    },
    "preferred-install": "dist"
  },
  "scripts": {
    "setup": "bash ./setup.sh",
    "post-install-cmd": [],
    "post-update-cmd": []
  },
  "extra": {
    "wordpress-install-dir": "public",
    "installer-paths": {
      "public/wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ],
      "public/wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "path",
      "url": "src/plugins/*",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "src/themes/*",
      "options": {
        "symlink": true
      }
    }
  ]
}
