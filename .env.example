DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PREFIX=wp_
DB_CHARSET=utf8mb4
DB_COLLATE=

WP_HOME=http://wordpress.test
WP_SITEURL=http://wordpress.test
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.test
WP_TITLE='Herd WordPress'

# Composer manages plugin packages in composer.json.
# Add packages with: composer require wpackagist-plugin/<plugin-slug>
# Example: composer require wpackagist-plugin/woocommerce
